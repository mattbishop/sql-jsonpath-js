{
  "name": "sql-jsonpath-js",
  "version": "2.0.2",
  "description": "JavaScript implementation of the SQL/JSONPath API from SQL:2023.",
  "keywords": [
    "sql",
    "jsonpath",
    "sql-2023",
    "json"
  ],
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "yarn build && node --test --import tsx test/*-tests.ts",
    "coverage": "yarn build && node --test --experimental-test-coverage --import tsx test/*-tests.ts",
    "benchmark": "node --import tsx benchmark/cases.ts",
    "clean": "node -e \"fs.rmSync('./dist', {recursive: true, force: true})\"",
    "build": "yarn clean && tsc",
    "diagram": "yarn build && node utils/generate-diagrams.js",
    "types": "yarn build && node utils/generate-parser-types.js",
    "prepack": "yarn build"
  },
  "author": "Matt Bishop, Marc Levin, Jeff Lowery",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattbishop/sql-jsonpath-js"
  },
  "dependencies": {
    "chevrotain": "^13.2.0",
    "safe-regex2": "^5.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/chai": "5.2.3",
    "@types/node": "^26.0.0",
    "chai": "6.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
